<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox on. No network, file, camera, contacts or other entitlements:
	     macOS blocks every connection attempt. Keep this file this short. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
